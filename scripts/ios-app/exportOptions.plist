<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store export options for `build-ios-app.sh archive` → -exportArchive.
  This is committed CONFIG (not a build artifact). `method = app-store-connect`
  is the App Store distribution channel (Xcode 15.3+ name; replaces the old
  `app-store`). NOT notarization/Developer-ID — that toolchain (notarytool /
  the `yijing-notary` profile) is for the macOS AppKit DMG's direct distribution,
  a different product. The teamID is the App Store team that owns the record; it
  is not a secret (it ships visibly in every signed build).
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>U9X7M39R56</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>destination</key>
	<string>export</string>
	<key>uploadSymbols</key>
	<true/>
	<key>generateAppStoreInformation</key>
	<true/>
</dict>
</plist>
