<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the app: lets the widget read the mirrored language/register. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.page.codeberg.jkaindl.Yijing</string>
	</array>
	<!-- Inert on iOS; required for the Mac Catalyst widget. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
