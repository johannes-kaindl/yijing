<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Yijing</string>
	<key>CFBundleDisplayName</key>
	<string>Yijing Orakel</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleIdentifier</key>
	<string>page.codeberg.jkaindl.Yijing</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Export compliance: the app uses only exempt HTTPS/TLS, no custom or
	     non-exempt cryptography. Declaring this once removes the manual
	     "Does your app use encryption?" prompt on every App Store/TestFlight upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- No LSRequiresIPhoneOS: Mac Catalyst forbids it, and this is one universal
	     Info.plist for both iOS and Catalyst, so the key is omitted entirely (iOS
	     accepts its absence; the App Store does not inject plist keys at submission).
	     If the iOS submission ever needs it, set it per-destination
	     (INFOPLIST_KEY_LSRequiresIPhoneOS + GENERATE_INFOPLIST_FILE, or a separate
	     iOS plist) — do NOT add it back to this shared plist. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The WKWebView loads the bundled app over http://localhost:<port>. ATS
	     must permit the loopback HTTP load. NSAllowsLocalNetworking covers
	     localhost/.local without opening arbitrary loads; the web-content key is
	     a belt-and-braces for WKWebView. Verify on a real device per iOS version. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Johannes Kaindl, AGPL-3.0-or-later</string>
	<!-- Deep link from the daily-hexagram widget: yijing://h/<n> opens the reader. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>page.codeberg.jkaindl.Yijing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yijing</string>
			</array>
		</dict>
	</array>
	<!-- Dev convenience: expose the Documents container (sweep exports,
	     Documents/yijing-test/) in the Files app / iTunes file sharing.
	     Harmless in release; UIFileSharingEnabled is inert on Catalyst. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
