<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Extra memory headroom for the resident on-device model + WebKit. Boolean,
	     no Apple pre-approval needed; grants no guaranteed amount. Gate the model
	     choice on os_proc_available_memory regardless (see ModelLocator). -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Mac App Store requires App Sandbox; these keys are inert on iOS. The
	     loopback NWListener that serves the embedded web shell needs the server
	     capability to bind; outbound (BYO endpoints, external links) needs client. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Shared container: the app mirrors language/register here so the Widget
	     and watchOS extensions read the user's choice. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.page.codeberg.jkaindl.Yijing</string>
	</array>
</dict>
</plist>
